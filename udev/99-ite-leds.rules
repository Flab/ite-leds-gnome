# Let the logged-in user control the ITE keyboard (600b) and lightbar (7001)
# controllers and the lightbar LED without root. Single-user laptop policy.
SUBSYSTEM=="usb", ATTR{idVendor}=="048d", ATTR{idProduct}=="600b", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="048d", ATTR{idProduct}=="7001", MODE="0666"
SUBSYSTEM=="leds", KERNEL=="rgb:lightbar", RUN+="/bin/chmod 0666 /sys%p/brightness /sys%p/multi_intensity"
